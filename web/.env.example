# 복사해서 web/.env.local 로 저장
# Supabase → Project Settings → API (anon/publishable 키만. service role 키는 절대 넣지 않는다)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# AI 백엔드 주소 (로컬: http://localhost:8000 / 배포: https://<HF 사용자>-<space>.hf.space)
NEXT_PUBLIC_API_URL=http://localhost:8000

# 구글 로그인(우리 도메인 경유) — 서버 전용, NEXT_PUBLIC_ 붙이지 않는다
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

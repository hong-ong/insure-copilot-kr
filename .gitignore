# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Secrets
.env
.env.*
!.env.example

# Data: 원문·가공 데이터는 커밋하지 않는다 (출처 목록과 다운로드 스크립트만)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Vector DB / local stores
chroma/
*.duckdb
*.duckdb.wal

# Eval outputs (요약표만 docs로 옮긴다)
eval/results/*
!eval/results/.gitkeep

# Editors / OS
.vscode/
.idea/
.DS_Store
.cursor/

# Claude Code local settings
.claude/settings.local.json

# Supabase CLI local cache
supabase/.temp/

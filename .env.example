# 복사해서 .env로 저장: cp .env.example .env
# ─── LLM (LiteLLM이 읽는 공급자 키) ───
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# 모델 (LiteLLM 모델 문자열). -latest 별칭은 Google이 최신 Flash로 자동 연결한다.
DEFAULT_MODEL=gemini/gemini-flash-latest
FALLBACK_MODEL=gemini/gemini-flash-lite-latest
EMBEDDING_MODEL=gemini/gemini-embedding-001
EMBEDDING_DIM=768
# Gemini 생각(thinking) 수준: low 권장 (기본값이면 짧은 답이 잘림)
REASONING_EFFORT=low
# 무료 티어여도 '상용 전환 시 비용'을 보여주기 위한 환산 단가 (USD / 1M tokens)
PRICE_INPUT_PER_M=0.30
PRICE_OUTPUT_PER_M=2.50

# (선택) Ollama 로컬 모델
LOCAL_MODEL=ollama/qwen2.5:7b
OLLAMA_API_BASE=http://localhost:11434

# ─── Supabase (Project Settings → API) ───
SUPABASE_URL=
SUPABASE_ANON_KEY=
# 서버 전용 키. 절대 화면(web/)에 넣지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# ─── 서비스 정책 ───
DEMO_DAILY_LIMIT=10
PARSE_APPROVE_THRESHOLD=0.90
PARSE_HOLD_THRESHOLD=0.70
OCR_MAX_PAGES=30
CORS_ORIGINS=http://localhost:3000

# ─── (선택) Langfuse 트레이스 ───
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# 국가법령정보 공동활용 Open API (승인 후 발급되는 OC 값)
LAW_API_OC=

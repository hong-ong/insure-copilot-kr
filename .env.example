# 복사해서 .env로 저장: cp .env.example .env
# LiteLLM이 읽는 공급자 키. 쓰는 것만 채우면 된다.
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# 기본 모델 (LiteLLM 모델 문자열). 예시값이니 공급자 문서에서 현재 모델명을 확인해 바꾼다.
DEFAULT_MODEL=gemini/gemini-2.5-flash
# (선택) Ollama 로컬 모델
LOCAL_MODEL=ollama/qwen2.5:7b
OLLAMA_API_BASE=http://localhost:11434

# 국가법령정보 공동활용 Open API (승인 후 발급되는 OC 값)
LAW_API_OC=
